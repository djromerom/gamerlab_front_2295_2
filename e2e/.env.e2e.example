# Copiar a e2e/.env.e2e (ignorado por git) y completar. Solo Arkad-test, nunca producción.

# Pruebas contra el front y la API de Arkad-test
E2E_BASE_URL=https://arkad-test.openlab.uninorte.edu.co
E2E_API_URL=https://arkad-app-test.openlab.uninorte.edu.co

# Acceso SSH al servidor de test (alias de ~/.ssh/config o usuario@host). La BD no publica puerto.
E2E_SSH_TARGET=

# Contenedor y base de datos de test (los valores por defecto ya son estos)
E2E_DB_CONTAINER=arkad_db
E2E_DB_USER=arkad_user
E2E_DB_NAME=arkad_db

# Contraseña de los jurados e2e- y su hash bcrypt (cost 10), que el seed guarda en usuarios.contrasena.
# Generar el hash una vez: npm i bcryptjs en una carpeta temporal y
#   node -e "console.log(require('bcryptjs').hashSync('<contraseña>', 10))"
E2E_JUROR_PASSWORD=
E2E_JUROR_PASSWORD_HASH=
